# The TypeScript fragment, as a grammar and nothing else.
#
# This file says what text is well formed. It says nothing about types: no type is
# named here, no rule means "a string goes here", and nothing in it depends on what
# has been declared. Which rule does what to the types is in fragment.types, and the
# names and their types come from the environment at runtime.
#
# Two naming conventions, neither of which says anything about types.
#
# A leading underscore means something outside this file refers to the rule by name,
# so grammar optimisation must not merge it away. Every underscored rule has a row in
# fragment.types, and every row names an underscored rule.
#
# A _lex_ prefix means more: the rule's legal content is not in this file at all, it
# comes from the symbol table at generation time. That has to be visible while the
# grammar is COMPILED, because compiling is where a token gets marked "always legal
# here" -- which is wrong for a position whose legal text nobody knows yet. Marking
# more rules than necessary is expensive: when the position before a newly declared
# name was wrongly included, its mask cost 15 ms instead of 9 us.
#
# Repetition is written with * and ? throughout, never as recursion. XGrammar has a
# fast path for a repeated character class; writing `ident ::= [a-zA-Z_] | [a-zA-Z_]
# ident_rest` instead predicts a fresh rule occurrence per byte, and measured 24 ms
# for one mask at the position after `let `, against a fraction of that for the same
# rule written as [a-zA-Z_] [a-zA-Z0-9_]*.
#
# A rule whose text is matched against the symbol table must spell its character
# classes out rather than delegating to a shared rule. The runtime refuses a byte
# only while the parser sits inside such a rule, so borrowing a shared tail would
# put the rest of every name outside it, where nothing is checked, and `coun`
# followed by anything at all would be accepted.

root           ::= [ \t\n]* stmt ([ \t\n]* stmt)* [ \t\n]*

stmt           ::= let_stmt | assign_stmt | declare_stmt

# "let x : T = e ;"
#
# The three [capture=...] attributes are how a declaration reaches the symbol table.
# A capture means "tell the caller what text this rule matched", and XGrammar records
# one only on a committed token, never while a mask is being computed -- which is the
# whole difficulty: rules complete thousands of times during mask generation on paths
# the model never takes, and registering a name from one of those would be wrong.
# The statement's own capture is the signal that the declaration is final; until the
# `;` lands, the name must not be usable, or `let x : number = x ;` would parse.
let_stmt[capture="statement"] ::= "let" [ \t\n]* _decl_name [ \t\n]* ":" [ \t\n]* _type_ann
                   [ \t\n]* "=" [ \t\n]* _expr [ \t\n]* ";"

# "x = e ;"
assign_stmt    ::= _assign_target [ \t\n]* "=" [ \t\n]* _expr [ \t\n]* ";"

# "declare function f(a: T): U ;" -- a signature and nothing else.
#
# No body, which is the point: it puts a function TYPE in scope, and so a new edge in
# the type graph, without `return`, nested scopes or closures. The parameter's name is
# an ordinary identifier because nothing can refer to it -- there is no body to refer
# to it from.
#
# The three captures are what reach the symbol table: the function's own name, and
# the two annotations, which together make the type it is declared with.
declare_stmt[capture="declaration"] ::= "declare" [ \t\n]* "function" [ \t\n]* _fn_name
                   [ \t\n]* "(" [ \t\n]* ident [ \t\n]* ":" [ \t\n]* _param_type [ \t\n]* ")"
                   [ \t\n]* ":" [ \t\n]* _return_type [ \t\n]* ";"

# A function being declared: a new name, like a variable's.
_fn_name[capture="fn_name"] ::= [a-zA-Z_] [a-zA-Z0-9_]*

# The two halves of the declared type. Separate rules only so the two captures can be
# told apart; neither constrains anything, since a signature has no expression in it.
_param_type[capture="param_type"] ::= type
_return_type[capture="return_type"] ::= type

_type_ann[capture="type"] ::= type
_assign_target ::= _lex_name

type           ::= "number" | "string" | "boolean"
                 | "number" "[" "]" | "string" "[" "]" | "boolean" "[" "]"

# Expressions. eq and _sum exist to give == and + their precedence, so that
# a + b == c groups as (a + b) == c, and b.c binds tighter than a + b.
_expr          ::= eq
eq             ::= _sum | _cmp
_cmp           ::= _cmp_operand [ \t\n]* "==" [ \t\n]* _cmp_operand
_cmp_operand   ::= _sum
_sum           ::= _primary ([ \t\n]* "+" [ \t\n]* _primary)*
_primary       ::= _num_lit | _str_lit | _bool_lit | _arr_lit | _postfix
                 | "(" [ \t\n]* _expr [ \t\n]* ")"

# An array literal's type is folded from its elements: [1, 2] is a number[] because
# every element is a number. The elements carry no requirement of their own -- what
# the position needs is checked once, on the whole literal -- so a mixed array is
# refused at the closing bracket rather than at the element that broke it. Empty
# arrays are NOT here: [] has no element to take a type from, so it needs the
# requirement itself, which is the same missing piece as a call argument's type.
_arr_lit       ::= "[" [ \t\n]* _arr_elem ([ \t\n]* "," [ \t\n]* _arr_elem)* [ \t\n]* "]"
_arr_elem      ::= eq

_num_lit       ::= [0-9] [0-9]*
_str_lit       ::= "\"" [a-zA-Z0-9 _.,!?-]* "\""
_bool_lit      ::= "true" | "false"

# A NAME, then any number of ".member" or "(argument)" steps, with NO whitespace
# inside the chain: `msg.split(msg)`, never `msg . split ( msg )`. Allowing it would
# put whitespace and a member name at the same position, which is the pattern that
# costs a factor of a thousand -- see the note on whitespace at the end of this file.
# Only a name takes
# them: `[1, 2].length`, `"abc".length` and `( e ).member` are not writable, where
# PLDI allows a member access on any expression. Recorded in STATUS.md.
_postfix       ::= _lex_name _trailer*
_trailer       ::= _member_step | _call_step
_member_step   ::= "." _lex_member
# A call is grammatical on any name. Whether the thing is callable is not a
# syntactic question, so the runtime refuses this step rather than the grammar.
#
# The two forms are separate rules because they apply the function differently: with
# an argument, the argument's own type is what gets applied; with none, there is
# nothing to complete inside the call, so the empty form has to do it itself.
_call_step     ::= _call_none | "(" [ \t\n]* _arg [ \t\n]* ")"
_call_none     ::= "(" [ \t\n]* ")"
_arg           ::= eq

# A name being DECLARED is unconstrained: any identifier is legal, whatever the
# types. It is captured so the caller can put it in the symbol table.
_decl_name[capture="name"] ::= [a-zA-Z_] [a-zA-Z0-9_]*

# A name being declared where nothing records it: a `declare function`'s own name and
# its parameter. Registering functions is not done yet.
ident          ::= [a-zA-Z_] [a-zA-Z0-9_]*

# A name being USED, and a member being named, come from the symbol table.
_lex_name      ::= [a-zA-Z_] [a-zA-Z0-9_]*
_lex_member    ::= [a-zA-Z_] [a-zA-Z0-9_]*

# Whitespace is flexible: any amount, anywhere, including newlines and indentation.
# It is written out as [ \t\n]* at every position and is deliberately NOT a rule of
# its own, which is worth a factor of 1,400 and costs the language nothing.
#
# A rule whose body is a repeated character class is the one thing on this grammar
# that XGrammar is slow at, when what follows it is an unconstrained identifier.
# Measured at the position after `let`, same vocabulary, same language, and the same
# 75,912 tokens offered either way:
#
#   "let" ws ident      with  ws ::= [ \t\n]*     16,512 us
#   "let" [ \t\n]* ident  spelled out inline        11.3 us
#
# It is not the number of legal tokens: 32,812 of them arrive in 3.4 us when they
# come from one precomputed set. And it is not rule references in general -- a rule
# holding a single space (sp ::= " ") costs 3.7 us. It is specifically the repetition
# living behind a rule reference, which is the same trap as writing repetition as
# recursion, measured at 24 ms in an earlier version of this grammar.
