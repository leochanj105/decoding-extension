# The TypeScript fragment, as a grammar and nothing else.
#
# This file says what text is well formed. It says nothing about types: no type is
# named here, no rule means "a string goes here", and nothing in it depends on what
# has been declared. Which rule does what to the types is in fragment.types, and the
# names and their types come from the environment at runtime.
#
# A leading underscore on a rule name means only that something outside this file
# refers to the rule by name, so grammar optimisation must not merge it away. It
# carries no meaning beyond that. Every underscored rule has a row in
# fragment.types, and every row names an underscored rule.
#
# Repetition is written with * and ? throughout, never as recursion. XGrammar has a
# fast path for a repeated character class; writing `ident ::= [a-zA-Z_] | [a-zA-Z_]
# ident_rest` instead predicts a fresh rule occurrence per byte, and measured 24 ms
# for one mask at the position after `let `, against a fraction of that for the same
# rule written as [a-zA-Z_] [a-zA-Z0-9_]*.
#
# A rule whose text is matched against the symbol table must spell its character
# classes out rather than delegating to a shared rule. The runtime refuses a byte
# only while the parser sits inside such a rule, so borrowing a shared tail would
# put the rest of every name outside it, where nothing is checked, and `coun`
# followed by anything at all would be accepted.

root           ::= ws stmt (ws stmt)* ws

stmt           ::= let_stmt | assign_stmt | declare_stmt

# "let x : T = e ;"
let_stmt       ::= "let" ws ident ws ":" ws _type_ann ws "=" ws _expr ws ";"

# "x = e ;"
assign_stmt    ::= _assign_target ws "=" ws _expr ws ";"

# "declare function f(a: T): U ;" -- a signature, no body, so no nested scopes
declare_stmt   ::= "declare" ws "function" ws ident ws "(" ws ident ws ":" ws type ws ")"
                   ws ":" ws type ws ";"

_type_ann      ::= type
_assign_target ::= _name

type           ::= "number" | "string" | "boolean"
                 | "number" "[" "]" | "string" "[" "]" | "boolean" "[" "]"

# Expressions. eq and _sum exist to give == and + their precedence, so that
# a + b == c groups as (a + b) == c, and b.c binds tighter than a + b.
_expr          ::= eq
eq             ::= _sum | _cmp
_cmp           ::= _cmp_operand ws "==" ws _cmp_operand
_cmp_operand   ::= _sum
_sum           ::= primary (ws "+" ws primary)*
primary        ::= _num_lit | _str_lit | _bool_lit | _postfix | "(" ws _expr ws ")"

_num_lit       ::= [0-9] [0-9]*
_str_lit       ::= "\"" [a-zA-Z0-9 _.,!?-]* "\""
_bool_lit      ::= "true" | "false"

# a name, then any number of ".member" or "(argument)" steps
_postfix       ::= _name _trailer*
_trailer       ::= _member_step | _call_step
_member_step   ::= "." _member_name
# A call is grammatical on any name. Whether the thing is callable is not a
# syntactic question, so the runtime refuses this step rather than the grammar.
_call_step     ::= "(" ws _expr ws ")"

# A name being DECLARED is unconstrained, so it is an ordinary rule.
ident          ::= [a-zA-Z_] [a-zA-Z0-9_]*

# A name being USED, and a member being named, come from the symbol table.
_name          ::= [a-zA-Z_] [a-zA-Z0-9_]*
_member_name   ::= [a-zA-Z_] [a-zA-Z0-9_]*

# Whitespace is flexible: any amount, anywhere, including newlines and indentation.
# This costs about 4% of generation time, measured over a whole statement, and was
# not worth crippling the language to avoid. The expensive positions are those where
# more whitespace AND an identifier are both legal, since every token that starts
# with a space and runs on into letters becomes a candidate to walk byte by byte.
ws             ::= [ \t\n]*
