# The typed TypeScript fragment.
#
# No type is named anywhere in this file. That is the whole point: one rule per
# construct, not one per type. Which types are involved is decided at runtime and
# carried in the parser state. See FRAGMENT_GRAMMAR.md for why each construct is
# here, and FRAGMENT.md for what was left out of TypeScript and why.
#
# Three rule-name prefixes are read by the matcher, not just by the parser:
#
#   __bind_<x>   on completing, the text it matched decides the type required of
#                whatever follows it
#   __lex_<x>    its legal content comes from the runtime symbol table, so the
#                grammar only says "an identifier goes here"
#   __check_<x>  it may only finish when the type it produced satisfies the type
#                its position requires
#
# These rules must survive grammar optimisation: the matcher finds them by name,
# so inlining one makes it silently disappear. RuleInliner exempts these prefixes.

root          ::= stmt (nl stmt)* nl?

stmt          ::= let_stmt | assign_stmt | declare_stmt

# "let x : T = e ;"  -- the annotation decides what e must produce
let_stmt      ::= "let " ident " : " __bind_type " = " __check_expr ";"

# "x = e ;"  -- the target's declared type decides what e must produce
assign_stmt   ::= __bind_target " = " __check_expr ";"

# "declare function f(a: T): U ;"  -- a signature, no body, so no nested scopes
declare_stmt  ::= "declare function " ident "(" ident " : " type ") : " type ";"

# the two places a requirement enters from text the model wrote
__bind_type   ::= type
__bind_target ::= __lex_name

type          ::= "number" | "string" | "boolean"
                | "number" "[" "]" | "string" "[" "]" | "boolean" "[" "]"

# Expressions. eq and sum exist only to give == and + their precedence, so that
# a + b == c groups as (a + b) == c and b.c binds tighter than a + b.
#
# Repetition is written with * and ? throughout, never as recursion. XGrammar has a
# fast path for a repeated character class and for a self-recursive element; writing
# `ident ::= [a-zA-Z_] | [a-zA-Z_] ident_rest` instead predicts a fresh rule
# occurrence per byte, and measured 24 ms for one mask at the position after `let `
# where any new name is legal. The same rule as [a-zA-Z_] [a-zA-Z0-9_]* is a fraction
# of that.
__check_expr  ::= eq
eq            ::= sum (" == " sum)?
sum           ::= primary (" + " primary)*
primary       ::= num_lit | str_lit | bool_lit | postfix | "(" __check_expr ")"

# a name, then any number of ".member" or "(argument)" steps
postfix       ::= __lex_name trailer*
trailer       ::= "." __lex_member | "(" __check_expr ")"

num_lit       ::= [0-9] [0-9]*
str_lit       ::= "\"" [a-zA-Z0-9 _.,!?-]* "\""
bool_lit      ::= "true" | "false"

# A name being DECLARED is unconstrained, so it is an ordinary rule.
ident         ::= [a-zA-Z_] [a-zA-Z0-9_]*

# A name being USED comes from the symbol table.
#
# These must NOT delegate to a shared rule such as ident_rest. The matcher vetoes a
# byte only when the state sits inside a __lex_ rule, so borrowing ident_rest would
# put the tail of every name inside an ordinary rule where nothing is vetoed -- and
# `coun` followed by anything would be accepted. Spelling the character class out
# keeps every byte of the name inside the lexicon rule.
__lex_name    ::= [a-zA-Z_] [a-zA-Z0-9_]*
__lex_member  ::= [a-zA-Z_] [a-zA-Z0-9_]*

# Whitespace is FIXED, not flexible, and that is a performance decision rather
# than a language one. Measured at the position after `let `: when whitespace and
# an identifier are both legal at the same place, the legal token set doubles --
# from 33,414 to 76,146 -- because every token starting with a space and running
# into letters becomes a candidate that must be walked one byte at a time. That
# cost one mask 17 ms instead of 221 us, a 78x difference, and it made no
# difference whether the whitespace was bounded or whether newlines were allowed:
# one-or-two spaces was as slow as unbounded.
#
# So separators are spelled out exactly, and a newline appears only between
# statements, where no identifier can start. The price is that generated code has
# one canonical layout and cannot be indented. Relaxing this is possible and costs
# about 150x, which is now a known number rather than a surprise.
nl            ::= "\n"
